
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GeneroEnum {
  FICCAO
  ROMANCE
  TERROR
  FANTASIA
  BIOGRAFIA
}

model Livro {
  id Int @id @default(autoincrement())
  titulo String
  autor String
  anoPublicacao Int?
  genero GeneroEnum
  qtdDisponivel Int

  @@map("livro")
}