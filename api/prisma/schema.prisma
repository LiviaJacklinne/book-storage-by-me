
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GeneroEnum {
  FICCAO
  ROMANCE
  TERROR
  FANTASIA
  BIOGRAFIA
}

model Livro {
  id Int @id @default(autoincrement())
  titulo String
  autor String
  anoPublicacao Int?
  genero GeneroEnum
  qtdDisponivel Int

  reservas ReservaLivro[]

  @@map("livro")
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String

  reservas ReservaLivro[]

  @@map("usuario")
}

enum ReservaStatusEnum {
  ATIVA
  EXPIRADA
  CONCLUIDA
}

model ReservaLivro {
  id         Int               @id @default(autoincrement())
  id_usuario Int
  id_livro   Int
  dataReserva   DateTime          @default(now())
  dataDevolucao   DateTime
  status     ReservaStatusEnum @default(ATIVA)

  usuario Usuario @relation(fields: [id_usuario], references: [id])
  livro   Livro   @relation(fields: [id_livro], references: [id])

  @@index([id_usuario])
  @@index([id_livro])
  @@index([status, dataDevolucao])
  @@map("reserva_livro")
}
